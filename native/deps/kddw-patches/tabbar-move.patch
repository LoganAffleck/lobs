+void DockWidgetModel::move(int from, int to)
+{
+    const int n = d->m_dockWidgets.size();
+    if (from < 0 || from >= n || to < 0 || to >= n || from == to)
+        return;
+    // Qt's destination row is "before which row", counted before the move.
+    beginMoveRows(QModelIndex(), from, from, QModelIndex(), to > from ? to + 1 : to);
+    d->m_dockWidgets.move(from, to);
+    endMoveRows();
+}
